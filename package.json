{
  "name": "mydocs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek-V4-Flash 双 DGX Spark 部署文档与脚本仓库",
  "scripts": {
    "cluster:status": "python scripts/check_status.py",
    "cluster:stop": "python scripts/cluster_stop.py",
