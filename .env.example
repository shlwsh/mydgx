# 双工作站敏感配置模板
# 复制本文件为项目根目录 .env 并填入真实值；.env 已被 .gitignore 排除，禁止入库。

# ---------- 工作站 Node0 (cube-f22b @ 172.19.50.70) ----------
NODE0_MGMT_IP=172.19.50.70
# 高速互联口地址：管理网(WLAN)不可达时自动回退，避免节点 IP 漂移导致失联
NODE0_FABRIC_IP=192.168.100.10
# Tailscale 地址（首选通道，跨网段稳定，不受 WLAN 状态影响）
NODE0_TAILSCALE_IP=100.67.107.19
SSH_NODE0_USER=winbot
SSH_NODE0_PASS=winbot
NODE0_RDP_USER=winbot
NODE0_RDP_PASS=winbot

# ---------- 工作站 Node1 (cube-0137 @ 172.19.49.159) ----------
NODE1_MGMT_IP=172.19.49.159
# 高速互联口地址：管理网(WLAN)不可达时自动回退，避免节点 IP 漂移导致失联
NODE1_FABRIC_IP=192.168.100.11
# Tailscale 地址（首选通道，跨网段稳定，不受 WLAN 状态影响）
NODE1_TAILSCALE_IP=100.103.250.108
SSH_OPS_USER=dgxdeploy
SSH_OPS_PASS=winning
NODE1_RDP_USER=his_test
NODE1_RDP_PASS=winning

# Node1 备份桌面账号 his_test（用于以该用户登录/运维）
SSH_NODE1_HIS_USER=his_test
SSH_NODE1_HIS_PASS=winning

# ---------- 工作站 Node123 (cube-fe5e @ 172.19.51.123) ----------
# 注意：该机 SSH 运维口令与 RDP 登录口令是两套不同凭据，切勿混用
NODE123_MGMT_IP=172.19.51.123
# Tailscale 地址（首选通道，跨网段稳定，不受 WLAN 状态影响）
NODE123_TAILSCALE_IP=100.79.120.65
SSH_NODE123_USER=bot
SSH_NODE123_PASS=ubuntu123
NODE123_RDP_USER=bot
NODE123_RDP_PASS=ubuntu123

# ---------- DeepSeek 云端 API（opencode 使用，双节点共用） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
